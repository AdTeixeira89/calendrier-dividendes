# Copier ce fichier en .env.local puis renseigner la configuration Web de votre projet Firebase
# (Console Firebase → Paramètres du projet → Vos applications → SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Développement local sans projet Firebase : "true" connecte l'app aux émulateurs
# (lancer `npm run dev:emulators` dans un autre terminal).
VITE_USE_EMULATORS=false
